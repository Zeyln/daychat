[Unit]
Description=daychat relay server
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/daychat-server --bind 0.0.0.0:7878 --secret-file /var/lib/daychat/server.secret
DynamicUser=yes
StateDirectory=daychat
Restart=on-failure
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_INET AF_INET6
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
